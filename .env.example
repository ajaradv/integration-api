# Postgres URL (libpq or asyncpg form). For Neon use the DIRECT (non-pooled) endpoint.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/paxafe
MAX_BODY_BYTES=262144
LOG_LEVEL=INFO
CLAIM_STALE_S=300
MAX_ATTEMPTS=5
WORKER_MAX_JOBS=4
WORKER_POLL_MIN_S=0.5
WORKER_POLL_MAX_S=5
JOB_TIMEOUT_S=30
HEARTBEAT_INTERVAL_S=10
HEARTBEAT_STALE_S=60
LIVEZ_GRACE_S=90

# Production values for the justfile (copy to .env, which is gitignored)
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# API_URL=https://paxafe-integration-api.onrender.com
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-...?key=...
# PROD_SENDER_API_KEY=pxk_...   (from `just neon-key`; set as INTEGRATION_API_KEY on the Render sender)
# PROD_OPERATOR_API_KEY=pxk_...
