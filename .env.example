# asyncpg URL. For Neon use the DIRECT (non-pooled) endpoint.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/paxafe
MAX_BODY_BYTES=262144
LOG_LEVEL=INFO
CLAIM_STALE_S=300
MAX_ATTEMPTS=5
WORKER_MAX_JOBS=4
WORKER_POLL_MIN_S=0.5
WORKER_POLL_MAX_S=5
JOB_TIMEOUT_S=30
HEARTBEAT_INTERVAL_S=10
HEARTBEAT_STALE_S=60
LIVEZ_GRACE_S=90
